# Optional: Custom database path (default: ./pipali.db/)
# POSTGRES_DB=

# Optional: App configuration
# PIPALI_HOST=127.0.0.1
# PIPALI_PORT=6464
# PIPALI_PLATFORM_URL=https://platform.pipali.ai
# PIPALI_ANON_MODE=false
# PIPALI_DEBUG=true
# LOG_LEVEL=info
# PIPALI_TELEMETRY_DISABLE=true

# Optional: Local browser authentication (username/password + email OTP)
# Enabled automatically on first deployment when the server is exposed beyond
# localhost (SUPERJOY_HOST != 127.0.0.1), so the first user can register their
# email. Set to true to force it on localhost, or false to opt out.
# SUPERJOY_LOCAL_AUTH=true
# RESEND_API_KEY=
# SUPERJOY_OTP_FROM="Superjoy <login@example.com>"
# SUPERJOY_SESSION_SECRET=

# Optional: HTTP Basic Auth for headless/non-browser use
# Requires SUPERJOY_BASIC_AUTH=true plus username and password.
# SUPERJOY_BASIC_AUTH=false
# SUPERJOY_AUTH_USERNAME=
# SUPERJOY_AUTH_PASSWORD=

# Optional: Disable sandbox for shell commands
# PIPALI_SANDBOX_DISABLED=true

# Optional: Limit research iterations (default: 100)
# PIPALI_RESEARCH_ITERATIONS=10

# Optional: Custom directories
# PIPALI_DATA_DIR=
# PIPALI_CONFIG_DIR=
# PIPALI_CACHE_DIR=
# PIPALI_LOGS_DIR=
# PIPALI_SKILLS_DIR=

# Optional: Direct model provider API keys
# By default, model access is provided via the Pipali Platform.
# Set these only if you want to use providers directly.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional: Search provider API keys (for self-hosted web search)
# SERPER_DEV_API_KEY=
# EXA_API_KEY=
# EXA_API_URL=https://api.exa.ai

# Set tauri update signing key to build desktop app locally
# TAURI_SIGNING_PRIVATE_KEY=key
