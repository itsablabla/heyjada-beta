{
  "$schema": "https://schemas.tauri.app/config/capability",
  "identifier": "default",
  "description": "Default capability set for HeyJada",
  "windows": ["main", "splashscreen"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:webview:allow-set-webview-zoom",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "pipali-server",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "opener:default",
    "dialog:default",
    "updater:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "/tmp/pipali/**"
        },
        {
          "path": "/private/tmp/pipali/**"
        }
      ]
    }
  ]
}
