<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow JIT compilation (required for Bun runtime) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Allow unsigned executable memory (required for Bun's JIT) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Disable library validation to allow loading Bun -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Microphone access for voice chat (required under hardened runtime) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
